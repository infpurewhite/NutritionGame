{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consumer-contract.schema.json",
  "title": "NutritionGame consumer contract for the andean-crops dataset",
  "description": "The fields this game reads from the dataset, and the units it relies on. Written in this repository: it is not the dataset's own schema, which the dataset file references as ./andean-crops.schema.json but which is not published next to it. Extra fields are allowed.",
  "type": "object",
  "required": [
    "metadata",
    "components",
    "crops"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "version",
        "basis",
        "verification_levels"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "verification_levels": {
          "type": "object"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "description": "energy must be reported in kcal",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "unit"
            ],
            "properties": {
              "id": {
                "const": "energy"
              },
              "unit": {
                "const": "kcal"
              }
            }
          }
        },
        {
          "description": "protein must be reported in g",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "unit"
            ],
            "properties": {
              "id": {
                "const": "protein"
              },
              "unit": {
                "const": "g"
              }
            }
          }
        },
        {
          "description": "fibre must be reported in g",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "unit"
            ],
            "properties": {
              "id": {
                "const": "fibre"
              },
              "unit": {
                "const": "g"
              }
            }
          }
        },
        {
          "description": "iron must be reported in mg",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "unit"
            ],
            "properties": {
              "id": {
                "const": "iron"
              },
              "unit": {
                "const": "mg"
              }
            }
          }
        },
        {
          "description": "calcium must be reported in mg",
          "contains": {
            "type": "object",
            "required": [
              "id",
              "unit"
            ],
            "properties": {
              "id": {
                "const": "calcium"
              },
              "unit": {
                "const": "mg"
              }
            }
          }
        }
      ]
    },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "names",
          "composition",
          "flags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "names": {
            "type": "object",
            "required": [
              "common",
              "es"
            ],
            "properties": {
              "common": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1,
                "description": "Spanish name (SPEC section 7)."
              },
              "alternative": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "composition": {
            "type": "object",
            "required": [
              "values"
            ],
            "properties": {
              "match": {
                "enum": [
                  "direct",
                  "proxy",
                  "unknown"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "value",
                    "verification"
                  ],
                  "properties": {
                    "value": {
                      "type": "number",
                      "minimum": 0
                    },
                    "verification": {
                      "enum": [
                        "verified",
                        "corroborated",
                        "unverified"
                      ]
                    }
                  }
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
