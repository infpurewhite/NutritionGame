{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pin.schema.json",
  "title": "Pin of the copied andean-crops dataset snapshot",
  "type": "object",
  "required": [
    "name",
    "version",
    "sourceUrl",
    "sha256",
    "retrievedOn"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "schemaUrl": {
      "type": "string",
      "format": "uri"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retrievedOn": {
      "type": "string",
      "format": "date"
    }
  }
}
