{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-intakes.schema.json",
  "title": "Daily reference intakes with their source citations (SPEC section 4)",
  "type": "object",
  "required": [
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "$ref": "#/$defs/sourceRef",
      "description": "Where the values in this file were copied from, if they were not sourced here."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "intakes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "$ref": "#/$defs/localisedText"
          },
          "intakes": {
            "type": "object",
            "required": [
              "energy",
              "protein",
              "fibre",
              "iron",
              "calcium"
            ],
            "additionalProperties": false,
            "properties": {
              "energy": {
                "$ref": "#/$defs/intake"
              },
              "protein": {
                "$ref": "#/$defs/intake"
              },
              "fibre": {
                "$ref": "#/$defs/intake"
              },
              "iron": {
                "$ref": "#/$defs/intake"
              },
              "calcium": {
                "$ref": "#/$defs/intake"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "description": "Citation for a stored value. 'locator' is the table, page or clause.",
      "required": [
        "citation"
      ],
      "additionalProperties": false,
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 10
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localisedText": {
      "type": "object",
      "required": [
        "es",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intake": {
      "type": "object",
      "required": [
        "amountPerDay",
        "unit",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "amountPerDay": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "kcal",
            "g",
            "mg"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
