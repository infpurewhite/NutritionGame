{
  "name": "nutrition-game",
  "version": "0.1.0",
  "private": true,
  "description": "Plate-builder game teaching balanced plates from Andean ingredients (prototype).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
